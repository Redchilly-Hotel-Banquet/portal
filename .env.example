# --- Required ---------------------------------------------------------------
MONGO_DB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGO_DB_NAME=redchilly
# At least 32 characters. Generate with: npm run generate-jwt
JWT_SECRET=
# Token lifetime (e.g. 12h, 24h)
TOKEN_EXPIRES_IN=12h

# --- Optional ---------------------------------------------------------------

# Google sign-in for guests and staff. The button only appears when both are set.
# Authorised redirect URI: <your-origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated Google accounts that always hold the admin role (first-admin
# bootstrap). Everyone else gets roles by editing their record in the `portal_users` collection.
ADMIN_GOOGLE_EMAILS=

# Key for encrypting saved ID details and signatures (16+ characters). Keep it stable: changing it
# makes previously saved details unreadable. Defaults to a key derived from JWT_SECRET.
PROFILE_ENCRYPTION_KEY=

# Public origin used for OAuth redirects and QR codes. Defaults to the request origin.
APP_URL=

# --- QR campaigns and rewards -----------------------------------------------
# The QR tools use the same database (MONGO_DB_URI / MONGO_DB_NAME) as the rest of the portal.
DEFAULT_CAMPAIGN_KEY=order-qr-code-reward
# QR administration uses the portal admin session; no separate QR credentials.
REWARD_COLLECTION=reward_qr_codes
REWARD_CUSTOMER_COLLECTION=reward_customers
REWARD_OPTION_COLLECTION=reward_options
USER_COLLECTION=users
REWARD_EXPIRY_MS=2592000000
REWARD_MAX_RECORDS=5000
REWARD_DELETE_ON_VERIFY=true
# Optional pipe-separated reward labels. Defaults are built in.
REWARD_OPTIONS=
# Optional QR verification URL overrides; otherwise APP_URL/request origin.
# Do not retain the old app's hostname here when moving rewards to this portal.
PUBLIC_BASE_URL=
DEV_PUBLIC_BASE_URL=
PROD_PUBLIC_BASE_URL=

# --- Storage & usage tab (all optional) ---------------------------------------
# Plan sizes shown on Settings -> Storage & usage. Defaults: 512 MB database, 10 GB R2.
DB_CAPACITY_MB=
R2_CAPACITY_GB=
# Cloudflare API token with Account -> Account Analytics -> Read, to show R2 request counts.
R2_TOKEN_VALUE=

# --- SQL database (Turso) for campaign visit tracking; optional, falls back to MongoDB ---
APP_TURSO_URL=
APP_TURSO_TOKEN=
# Management token, only to show monthly rows read/written on Settings -> Storage & usage.
APP_TURSO_API_TOKEN=
